GMGN_API_KEY=your_gmgn_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Set to 'true' to actually send Telegram messages. 'false' = dry-run (log only)
TELEGRAM_SEND_ENABLED=false
# Poll interval in milliseconds (default: 60s)
POLL_INTERVAL_MS=60000
# Filter config path (default: filters.config.json in project root)
FILTERS_CONFIG_PATH=./filters.config.json
# Heartbeat interval in cycles. Default: 1 if POLL_INTERVAL_MS >= 300000, else 5
HEARTBEAT_EVERY_N_CYCLES=1